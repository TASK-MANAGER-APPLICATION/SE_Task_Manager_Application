# PostgreSQL. For Neon, use the pooled development connection string
# and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PORT=3000

# Comma-separated exact browser origins. Native Android requests do not send an Origin header.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Brevo transactional email API. Never commit real credentials.
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=YOUR_VERIFIED_SENDER_EMAIL
BREVO_SENDER_NAME=Task Manager

# Uses the `mobile` scheme configured in mobile/app.json.
PASSWORD_RESET_URL=mobile://reset-password
