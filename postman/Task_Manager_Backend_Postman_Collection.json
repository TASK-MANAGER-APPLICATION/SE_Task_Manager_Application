{
  "info": {
    "name": "Task Manager Backend - API and Security Tests",
    "description": "Postman collection for the local Task Manager API. Use only the dedicated test database. Run Login before authenticated requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "abdullah.postman.test@example.com"
    },
    {
      "key": "password",
      "value": "TestPass123!"
    },
    {
      "key": "name",
      "value": "Postman Test User"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Authentication",
      "item": [
        {
          "name": "Register test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"{{name}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register created or already exists', () => pm.expect([201,409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login and save token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Token returned and hash not exposed', () => { pm.expect(data.token).to.be.a('string').and.not.empty; pm.expect(data.user).not.to.have.property('password_hash'); });",
                  "if (data.token) pm.collectionVariables.set('token', data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login missing password (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing password returns 400', () => pm.response.to.have.status(400));",
                  "pm.test('Validation error code', () => pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register invalid email (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"TestPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid email returns 400', () => pm.response.to.have.status(400));",
                  "pm.test('INVALID_EMAIL code', () => pm.expect(pm.response.json().code).to.eql('INVALID_EMAIL'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register weak password (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"weak-password-test@example.com\",\n  \"password\": \"weakpass\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Weak password returns 400', () => pm.response.to.have.status(400));",
                  "pm.test('WEAK_PASSWORD code', () => pm.expect(pm.response.json().code).to.eql('WEAK_PASSWORD'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Tasks (login first)",
      "item": [
        {
          "name": "List my tasks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('List returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('tasks array returned', () => pm.expect(pm.response.json().tasks).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create task and save taskId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman test task\",\n  \"description\": \"Created by the API test collection\",\n  \"priority\": \"High\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create returns 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test('Task returned', () => pm.expect(data.task.title).to.eql('Postman test task'));",
                  "if (data.task && data.task.id !== undefined) pm.collectionVariables.set('taskId', String(data.task.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject empty title (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"   \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Empty title returns 400', () => pm.response.to.have.status(400));",
                  "pm.test('INVALID_TITLE code', () => pm.expect(pm.response.json().code).to.eql('INVALID_TITLE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid priority (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Invalid priority test\",\n  \"priority\": \"Urgent\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid priority returns 400', () => pm.response.to.have.status(400));",
                  "pm.test('INVALID_PRIORITY code', () => pm.expect(pm.response.json().code).to.eql('INVALID_PRIORITY'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit task",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman test task - edited\",\n  \"priority\": \"Medium\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Edit returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Title updated', () => pm.expect(pm.response.json().task.title).to.eql('Postman test task - edited'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete task",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/complete"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Complete returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is Completed', () => pm.expect(pm.response.json().task.status).to.eql('Completed'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete task",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Delete returns 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Security checks",
      "item": [
        {
          "name": "Access tasks without token (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No token returns 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Access tasks with invalid token (expect 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer definitely-not-a-valid-token"
              }
            ],
            "url": "{{baseUrl}}/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid token returns 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid task ID (expect 400)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tasks/not-a-number",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Invalid ID test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Malformed ID returns 400', () => pm.response.to.have.status(400));",
                  "pm.test('INVALID_TASK_ID code', () => pm.expect(pm.response.json().code).to.eql('INVALID_TASK_ID'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (invalidates token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout returns 204', () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.set('token', '');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}